+    #[tokio::test]
+    async fn untracked_diff_requests_share_limit_and_preserve_order() {
+        use std::sync::Arc;
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        let active = Arc::new(AtomicUsize::new(0));
+        let peak = Arc::new(AtomicUsize::new(0));
+        let mut tasks = Vec::new();
+        for batch in 0..2 {
+            let active = active.clone();
+            let peak = peak.clone();
+            // Spawning also checks that the stream and its output remain Send.
+            tasks.push(tokio::spawn(async move {
+                let diffs = (0..16).map(|index| {
+                    let active = active.clone();
+                    let peak = peak.clone();
+                    async move {
+                        let count = active.fetch_add(1, Ordering::SeqCst) + 1;
+                        peak.fetch_max(count, Ordering::SeqCst);
+                        tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+                        active.fetch_sub(1, Ordering::SeqCst);
+                        batch * 16 + index
+                    }
+                });
+                bounded_untracked_diffs(diffs).collect::<Vec<_>>().await
+            }));
+        }
+        for (batch, task) in tasks.into_iter().enumerate() {
+            let actual = task.await.expect("batch completed");
+            let expected: Vec<_> = (batch * 16..batch * 16 + 16).collect();
+            assert_eq!(actual, expected);
+        }
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+        assert!(peak.load(Ordering::SeqCst) > 0);
+        assert!(peak.load(Ordering::SeqCst) <= UNTRACKED_DIFF_CONCURRENCY);
+    }
+
