+// Limit both one request and overlapping requests before polling spawn futures.
+// Buffered preserves listing order; RAII releases the slot on cancellation.
+fn bounded_untracked_diffs<I, F>(diffs: I) -> impl futures::Stream<Item = F::Output> + Send
+where
+    I: IntoIterator<Item = F>,
+    I::IntoIter: Send,
+    F: std::future::Future + Send,
+    F::Output: Send,
+{
+    stream::iter(diffs)
+        .map(|diff| async move {
+            let _slot = UNTRACKED_DIFF_SLOTS
+                .acquire()
+                .await
+                .expect("untracked diff semaphore is never closed");
+            diff.await
+        })
+        .buffered(UNTRACKED_DIFF_CONCURRENCY)
+}
